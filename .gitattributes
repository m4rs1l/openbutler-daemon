# Normalize line endings: sources are authored and stored as LF, on every
# platform. This is what stops the per-file "LF will be replaced by CRLF"
# churn on Windows checkouts.
* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# The prompt assets are a byte contract with the legacy sources: git must
# never rewrite their line endings on any platform, in any module's
# prompts directory.
**/prompts/*.txt -text

*.png binary
*.jpg binary
*.ico binary
