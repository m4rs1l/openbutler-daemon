{
  "cases": [
    {
      "name": "auth admitted as first frame",
      "frame": { "version": 2, "id": "a1", "action": "auth", "token": "obt_example_token" },
      "expect": { "kind": "auth", "id": "a1" }
    },
    {
      "name": "pair admitted as first frame",
      "frame": { "version": 2, "id": "p1", "action": "pair", "code": "4821-1937" },
      "expect": { "kind": "pair", "id": "p1" }
    },
    {
      "name": "well-formed request as first frame",
      "frame": { "version": 2, "id": "s1", "action": "status" },
      "expect": { "kind": "refused", "id": "s1" }
    },
    {
      "name": "wrong version refused",
      "frame": { "version": 1, "id": "a2", "action": "auth", "token": "obt_x" },
      "expect": { "kind": "refused", "id": "a2" }
    },
    {
      "name": "empty id refused",
      "frame": { "version": 2, "id": "", "action": "auth", "token": "obt_x" },
      "expect": { "kind": "refused", "id": "" }
    },
    {
      "name": "missing id refused",
      "frame": { "version": 2, "action": "auth", "token": "obt_x" },
      "expect": { "kind": "refused", "id": "" }
    },
    {
      "name": "non-string token refused",
      "frame": { "version": 2, "id": "a3", "action": "auth", "token": 42 },
      "expect": { "kind": "refused", "id": "a3" }
    },
    {
      "name": "non-string code refused",
      "frame": { "version": 2, "id": "p2", "action": "pair", "code": 7 },
      "expect": { "kind": "refused", "id": "p2" }
    },
    {
      "name": "array refused with empty id",
      "frame": ["not", "a", "record"],
      "expect": { "kind": "refused", "id": "" }
    },
    {
      "name": "plain string refused with empty id",
      "frame": "hello",
      "expect": { "kind": "refused", "id": "" }
    }
  ],
  "messages": {
    "firstFrameRefused": "This connection is remote and must authenticate first: send { version, id, action: \"auth\", token } as the first frame.",
    "authFailed": "Authentication failed: this host does not accept that token.",
    "pairFailed": "Pairing failed: that code is wrong, expired, or already used."
  },
  "success": {
    "auth": { "authenticated": true },
    "pair": { "token": "obt_example_minted_token" }
  }
}
